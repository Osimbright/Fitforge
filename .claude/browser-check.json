{
  "baseUrl": "http://localhost:3123",
  "publicRoutes": ["/", "/login", "/signup", "/forgot-password", "/reset-password", "/privacy", "/terms"],
  "appRoutes": [
    "/dashboard", "/workouts", "/workouts/log", "/workouts/history",
    "/exercises", "/diet", "/progress", "/coach", "/profile"
  ],
  "dynamicRoutes": [
    { "pattern": "^/exercises/[^/?]+$", "label": "/exercises/[id]" },
    { "pattern": "^/workouts/session/[^/?]+$", "label": "/workouts/session/[id]" }
  ],
  "login": { "path": "/login", "email": "#email", "password": "#password", "submit": "button[type=\"submit\"]", "errorText": "wrong email or password|invalid" },
  "blockRequests": "/api/ai/",
  "authedApiChecks": ["/api/export"],
  "qaUser": {
    "metadata": { "full_name": "Browser Check" },
    "afterLoginPath": "/onboarding",
    "pagesBeforeSetup": ["/onboarding"],
    "setup": [
      {
        "table": "profiles",
        "match": { "id": "$USER_ID" },
        "update": {
          "full_name": "Browser Check", "gender": "male", "dob": "1995-05-05", "height_cm": 178, "weight_kg": 80,
          "target_weight_kg": 75, "experience_level": "intermediate", "training_months": 12, "goal": "build_muscle",
          "days_per_week": 4, "session_minutes": 60, "training_location": "gym", "diet_type": "omnivore",
          "cuisine": "any", "meals_per_day": 3, "activity_level": "moderate", "bmr": 1780, "tdee": 2760,
          "calorie_target": 3000, "protein_g": 160, "carbs_g": 360, "fat_g": 90, "water_ml": 2800,
          "onboarding_step": 6, "onboarding_complete": true
        }
      },
      {
        "table": "body_metrics",
        "upsert": { "user_id": "$USER_ID", "log_date": "$TODAY", "weight_kg": 80 },
        "onConflict": "user_id,log_date"
      }
    ]
  }
}
