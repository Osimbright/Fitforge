# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only — used for seeding and account deletion. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic Console → API Keys. Server only.
ANTHROPIC_API_KEY=sk-ant-...

# Public URL of the app (used in auth email links). Optional locally.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
